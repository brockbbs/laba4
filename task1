import math

def calculate_sum():
    total_sum = 0.0
    for n in range(1, 51):
        numerator = ((-1) ** n) * math.cos(n)
        denominator = (2 * n + 1) * (0.9 ** (2 * n + 1))
        total_sum += numerator / denominator
    return total_sum
result = calculate_sum()
print(f"Сумма ряда: {result:.6f}")
