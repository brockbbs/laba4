def calculate_product():
    total_product = 1.0
    for n in range(1, 11):
        numerator = n**2 + n + 1
        # 1. (n / 10) ^ (n / 10)
        part1 = (n / 10) ** (n / 10)
        part2 = (n**2) / 2
        denominator = part1 + part2 + 9
        total_product *= numerator / denominator
    return total_product
result = calculate_product()
print(f"Значение произведения: {result:.6f}")
